{
  "name": "dsh-ccg",
  "version": "0.5.0",
  "type": "module",
  "description": "CCG's multi-model role matrix for DeepSeek Harness: seven role-pinned delegation tools (analyze / design / build / debug / optimize / review / test), each on its own model with its own expert persona. Any role can hold several models and answer as a panel, or be hired as a live teammate with its own files. Durable ownership and project memory. Pure provider API — no external CLI.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "subagent",
    "multi-model",
    "model-routing",
    "ccg",
    "code-review",
    "agent"
  ],
  "license": "MIT",
  "private": true,
  "author": {
    "name": "CCG Contributors",
    "url": "https://github.com/Pyrokine/ccg-workflow"
  },
  "homepage": "https://github.com/Pyrokine/ccg-workflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pyrokine/ccg-workflow.git",
    "directory": "dsh-ccg"
  },
  "bugs": {
    "url": "https://github.com/Pyrokine/ccg-workflow/issues"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./roles": "./src/roles.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || ^4.0.5-alpha.1",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.2 <0.2.2-0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.2 <0.2.2-0",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.2 <0.2.2-0",
    "@deepseek-ai/dsh-tool-subagent": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.2 <0.2.2-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.2 <0.2.2-0",
    "@deepseek-ai/schemastery": "^3.18.4 || ^3.18.5-alpha.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.2 <0.2.2-0",
    "zod": "^4.0.0",
    "@deepseek-ai/cosmokit": "^1.8.5 || ^1.8.6-alpha.1"
  },
  "scripts": {
    "lint": "node --check src/index.js && node --check src/roles.js && node --check src/crosscheck.js && node --check src/team.js && node --check src/modes.js && node --check src/memory.js && node --check src/knowledge.js && node --check src/api.js && node --check src/client.js && node --check src/subagent.js",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "^4.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
