{
  "name": "ccg-workflow",
  "version": "3.6.7-aug.1",
  "description": "Multi-model collaboration workflow for Claude Code, Codex, Antigravity, Grok, Kimi Code, and OpenCode",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.13.0 || >=24.19.0"
  },
  "author": {
    "name": "CCG Contributors"
  },
  "license": "MIT",
  "keywords": [
    "claude",
    "codex",
    "antigravity",
    "grok",
    "kimi",
    "opencode",
    "multi-model",
    "ai",
    "collaboration",
    "cli",
    "workflow"
  ],
  "bin": {
    "ccg": "bin/ccg.mjs"
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "bin/ccg.mjs",
    "assets/sponsors/",
    "dist",
    "dsh-ccg/src/",
    "dsh-ccg/skills/",
    "dsh-ccg/package.json",
    "dsh-ccg/cordis.patch.yml",
    "dsh-ccg/README.md",
    "dsh-ccg/README.zh-CN.md",
    "dsh-ccg/LICENSE",
    "templates/commands/",
    "templates/commands-legacy/",
    "templates/engine/",
    "templates/hooks/",
    "templates/codex/",
    "templates/prompts/codex/",
    "templates/prompts/claude/",
    "templates/prompts/antigravity/",
    "templates/prompts/grok/",
    "templates/prompts/kimi/",
    "templates/prompts/opencode/",
    "templates/output-styles/",
    "templates/skills/SKILL.md",
    "templates/skills/package.json",
    "templates/skills/run_skill.js",
    "templates/skills/adsense-site-auditor/",
    "templates/skills/bt-panel/",
    "templates/skills/impeccable/",
    "templates/skills/orchestration/",
    "templates/skills/scrapling/",
    "templates/skills/seo-page-builder/",
    "templates/skills/tools/",
    "templates/skills/domains/ai/",
    "templates/skills/domains/architecture/",
    "templates/skills/domains/data-engineering/",
    "templates/skills/domains/development/",
    "templates/skills/domains/devops/",
    "templates/skills/domains/frontend-design/",
    "templates/skills/domains/infrastructure/",
    "templates/skills/domains/mobile/",
    "templates/skills/domains/orchestration/",
    "templates/rules/"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "unbuild",
    "start": "node bin/ccg.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{json,js}\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "ansis": "^4.3.1",
    "cac": "^7.0.0",
    "fs-extra": "^11.4.0",
    "i18next": "^26.3.6",
    "i18next-fs-backend": "^2.6.7",
    "inquirer": "^14.0.2",
    "ora": "^9.4.1",
    "pathe": "^2.0.3",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "unbuild": "^3.6.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  }
}
